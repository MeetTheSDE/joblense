{
    "manifest_version": 3,
    "name": "JobLense: LinkedIn Jobs Words Highlighter",
    "version": "1.0",
    "description": "Highlights specific words instantly on LinkedIn Jobs.",
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "content_scripts": [
        {
            "matches": ["https://www.linkedin.com/jobs/*"],
            "js": ["content.js"],
            "css": ["styles.css"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        },
        "default_popup": "popup.html"
    },
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://www.linkedin.com/jobs/*"]
}
